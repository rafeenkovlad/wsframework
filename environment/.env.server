# WsFramework Local Environment

SUBNET=192.163.0.0/24
PHP_INI=development-php.ini

WSFRAMEWORK_COMMAND='php public/index.php start'
WSFRAMEWORK_IP=192.163.0.120

# NATS JetStream
APP_NATS_HOST=nats
APP_NATS_PORT=4222
NATS_DELAY_NACK_IN_LOOP=5
NATS_JETSTREAM_HTTP_HOST=0.0.0.0
NATS_JETSTREAM_HTTP_PORT=8091
NATS_JETSTREAM_COUNT_PROCESS=1

# FFmpeg Container
FFMPEG_IP=192.163.0.121
FFMPEG_COMMAND='php public/ffmpeg-worker.php start'
FFPROBE_BINARY_PATH=/usr/local/bin/ffprobe
FFMPEG_FILES_DIRECTORY=/var/www/html/public/files/
FFMPEG_TIMEOUT=3600
FFMPEG_THREADS=0
FFMPEG_MAX_CONCURRENT_JOBS=2
FFMPEG_MAX_RETRIES=3
FFMPEG_BINARY_PATH=/usr/local/bin/ffmpeg

FFMPEG_QUEUE_DLQ_COUNT_PROCESS=1
FFMPEG_QUEUE_DLQ_PROCESS_PORT=2035
FFMPEG_QUEUE_DLQ_PROCESS_HOST=FfmpegQueueDQLProcess.sock

FFMPEG_QUEUE_COUNT_PROCESS=1
FFMPEG_QUEUE_PROCESS_PORT=2036
FFMPEG_QUEUE_PROCESS_HOST=FfmpegQueueProcess.sock

# S3 Pipeline
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_DOWNLOAD_COUNT_PROCESS=1
S3_DOWNLOAD_PROCESS_HOST=s3DownloadProcess.sock
S3_UPLOAD_COUNT_PROCESS=1
S3_UPLOAD_PROCESS_HOST=s3UploadProcess.sock
S3_PIPELINE_MAX_RETRIES=3
S3_UPLOAD_CONCURRENCY=3
S3_WORKER_COMMAND='php public/s3-worker.php start'

# Browserless
BROWSERLESS_QUEUE_COUNT_PROCESS=1
BROWSERLESS_QUEUE_PROCESS_HOST=browserless-queue.sock
BROWSERLESS_WORKER_COMMAND=bash -c "node /usr/src/app/build/index.js & while ! curl -s http://localhost:3000 > /dev/null 2>&1; do sleep 1; done && php /var/www/html/public/browserless-worker.php start"
BROWSERLESS_API_URL=http://localhost:3000
BROWSERLESS_PROXY_URL=
BROWSERLESS_PROXY_USERNAME=
BROWSERLESS_PROXY_PASSWORD=
BROWSERLESS_STEALTH_ENABLED=true
BROWSERLESS_PROFILES_DIR=/var/www/html/storage/profiles/
BROWSERLESS_CLIENT_TIMEOUT=180

# Idle Check
IDLE_CHECK_INTERVAL_SEC=60

#VPS cloud server
CLOUD_SERVER_ID=
CLOUD_SERVER_API_URL=
CLOUD_SERVER_API_KEY=

# API Auth
HTTP_API_KEY=