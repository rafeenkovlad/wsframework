{
    "name": "wswalker/wsframework",
    "description": "Async multiprocess Workerman framework — infrastructure layer",
    "type": "library",
    "repositories": [
        {
            "type": "path",
            "url": "lib/packages/nats-client"
        }
    ],
    "autoload": {
        "psr-4": {
            "WsFramework\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "require": {
        "php": "^8.4",
        "workerman/workerman": "^5.1.8",
        "workerman/channel": "^1.2.2",
        "workerman/globaldata": "^1.0",
        "symfony/dotenv": "^5.4",
        "symfony/validator": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/config": "^8.0",
        "symfony/yaml": "^7.4",
        "psx/api": "7.5.0",
        "hyperf/stringable": "^3.1",
        "revolt/event-loop": "^1.0",
        "psr/clock": "^1.0",
        "package/nats-client": "*",
        "aminyazdanpanah/php-ffmpeg-video-streaming": "^1.3.0",
        "aws/aws-sdk-php": "^3.0",
        "hyperf/guzzle": "^3.1",
        "basis-company/nats": "^1.1.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
