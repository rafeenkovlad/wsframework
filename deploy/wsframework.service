[Unit]
Description=WsFramework Docker Compose
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/www/html
ExecStart=/var/www/html/scripts/restart.sh
ExecStop=/var/www/html/scripts/stop.sh
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
