		"name": "FFmpeg Queue API",
		"description": "JSON-RPC 2.0 API for FFmpeg Queue service.\n\nПайплайн: S3 Download → FFmpeg HLS → S3 Upload → Cleanup.\n\nВсе методы принимают JSON-RPC 2.0 запросы (POST). Ответы содержат типизированную структуру JobKVDTO с вложенными объектами стадий (s3Download, ffmpegJob, s3Upload, cleanup).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8091"
		},
		{
			"key": "jobId",
			"value": "job-uuid-here"
		}
	],
