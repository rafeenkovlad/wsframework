							"mode": "raw",
							"raw": "{\n\t\"id\": 1,\n\t\"method\": \"FfmpegQueue.CancelJob\",\n\t\"params\": {\n\t\t\"jobId\": \"{{jobId}}\"\n\t}\n}"
						},
						"url": {
							"raw": "{{baseUrl}}",
							"host": [
								"{{baseUrl}}"
							]
						},
						"description": "Отменить задачу со статусом pending, на стадии S3 или со статусом restarted.\n\nИспользует optimistic locking (revision) — при конкурентном изменении вернёт ошибку.\n\nДопустимые статусы для отмены: pending, s3_download_pending, s3_downloading, s3_upload_pending, s3_uploading, s3_download_restarted, processing_restarted, s3_upload_restarted."
					},
					"response": [
						{
							"name": "Success — job cancelled",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
