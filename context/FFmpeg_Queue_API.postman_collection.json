								"body": {
									"mode": "raw",
									"raw": "{\n\t\"id\": 1,\n\t\"method\": \"FfmpegQueue.CancelJob\",\n\t\"params\": {\n\t\t\"jobId\": \"a1b2c3d4e5f67890abcdef1234567890\"\n\t}\n}"
								},
								"url": {
									"raw": "{{baseUrl}}",
