		{
			"name": "Pipeline",
			"description": "Запуск и управление пайплайном обработки видео.",
			"item": [
				{
					"name": "processVideoCallback",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"id\": 1,\n\t\"method\": \"FfmpegQueue.ProcessVideoCallback\",\n\t\"params\": {\n\t\t\"s3Key\": \"input/video.mp4\",\n\t\t\"s3Bucket\": \"my-bucket\",\n\t\t\"outputS3Prefix\": \"output/hls/\",\n\t\t\"maxRetries\": 3\n\t}\n}"
						},
						"url": {
							"raw": "{{baseUrl}}",
							"host": [
								"{{baseUrl}}"
							]
						},
						"description": "Запустить полный пайплайн: S3 Download → FFmpeg HLS → S3 Upload.\n\nПараметры:\n- s3Key (required) — ключ файла в S3-бакете\n- s3Bucket — имя бакета (по умолчанию из ENV)\n- outputS3Prefix — префикс для выходных HLS-файлов в S3\n- maxRetries — максимальное число ретраев для S3 операций"
					},
					"response": [
						{
							"name": "Success — job created",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n\t\"id\": 1,\n\t\"method\": \"FfmpegQueue.ProcessVideoCallback\",\n\t\"params\": {\n\t\t\"s3Key\": \"input/video.mp4\"\n\t}\n}"
								},
								"url": {
									"raw": "{{baseUrl}}",
									"host": [
										"{{baseUrl}}"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"body": "{\n\t\"id\": 1,\n\t\"result\": {\n\t\t\"jobId\": \"a1b2c3d4e5f67890abcdef1234567890\",\n\t\t\"status\": \"s3_download_pending\"\n\t}\n}"
						}
					]
